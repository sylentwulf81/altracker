# Supabase connection. Copy to .env.local and fill in from:
#   Supabase dashboard -> Project Settings -> API
# The publishable key is designed to be public; RLS enforces access control.
# The service_role key must NEVER appear here or in any client-side file.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
